@startuml MiniCAD

title Diagramma delle classi - MiniCAD OOP

top to bottom direction
skinparam linetype ortho
skinparam classAttributeIconSize 0

abstract class EntitaGeometrica {
    - id : int
    - nome : string
    - colore : Colore
    - layer : Layer

    {abstract} + Descrizione() : string
}

class Punto {
    - x : double
    - y : double

    + Distanza(altro : Punto) : double
}

class Linea {
    - inizio : Punto
    - fine : Punto

    + Lunghezza() : double
}

abstract class FiguraGeometrica {
    + vertici : IReadOnlyList~Punto~

    {abstract} + Area() : double
    {abstract} + Perimetro() : double
}

class Rettangolo {
    + Area() : double
    + Perimetro() : double
}

class Quadrato {
    + Area() : double
    + Perimetro() : double
}

class Triangolo {
    + Area() : double
    + Perimetro() : double
}

class DocumentoCAD {
    - nome : string
    - entita : List~EntitaGeometrica~

    + AggiungiEntita(entita : EntitaGeometrica) : void
    + EliminaEntita(id : int) : bool
    + CercaEntita(id : int) : EntitaGeometrica
    + StampaElenco() : void
    + ContaEntita() : int
}

class Layer {
    - nome : string
    - visibile : bool

    + Attiva() : void
    + Disattiva() : void
}

enum Colore {
    Nero
    Rosso
    Verde
    Blu
    Giallo
    Magenta
    Ciano
}

EntitaGeometrica <|-- Punto
EntitaGeometrica <|-- Linea
EntitaGeometrica <|-- FiguraGeometrica
FiguraGeometrica <|-- Rettangolo
FiguraGeometrica <|-- Quadrato
FiguraGeometrica <|-- Triangolo

DocumentoCAD "1" o-- "*" EntitaGeometrica
Linea "0..*" --> "1" Punto : inizio
Linea "0..*" --> "1" Punto : fine
FiguraGeometrica "1" -- "0..*" Punto : vertici
EntitaGeometrica "*" --> "1" Layer
EntitaGeometrica --> Colore

note right of Triangolo
  Vincolo: esattamente 3 vertici distinti
  e non allineati.
end note

note right of Rettangolo
  Vincolo: esattamente 4 vertici ordinati
  lungo il contorno, che definiscono
  un rettangolo valido.
end note

note right of Quadrato
  Vincolo: esattamente 4 vertici ordinati
  lungo il contorno, con tutti i lati uguali
  e tutti gli angoli interni retti.
end note

note left of FiguraGeometrica
  **Ordine dei vertici:** i vertici sono memorizzati
  nell'ordine in cui si incontrano percorrendo il
  contorno della figura. Il lato successivo collega
  ciascun vertice al successivo; l'ultimo vertice è
  collegato al primo. L'ordine deve consentire di
  rappresentare correttamente il contorno senza
  auto-intersezioni.
end note

@enduml
